{
  "version": "2026-08-24",
  "requiredDocMetadata": [
    "文档类型",
    "状态",
    "版本",
    "生效日期",
    "最后审查日期",
    "维护人",
    "唯一依据",
    "替代文档"
  ],
  "governedDocGlobs": [
    "docs/README.md",
    "docs/architecture/*.md",
    "docs/business-rules/*.md",
    "docs/business-rules/baselines/*.md",
    "docs/governance/*.md",
    "docs/governance/change-records/*.md",
    "docs/operations/*.md",
    "docs/operations/finance/*.md",
    "docs/prd/source/14-变更记录与决策记录.md"
  ],
  "allowedDocsRootFiles": [
    "docs/README.md"
  ],
  "allowedDocsTopLevelDirs": [
    "docs/archive/",
    "docs/architecture/",
    "docs/business-rules/",
    "docs/governance/",
    "docs/operations/",
    "docs/performance-governance/",
    "docs/prd/",
    "docs/reports/",
    "docs/superpowers/",
    "docs/ui-reference/"
  ],
  "allowedRepoRootFiles": [
    ".gitignore",
    "AGENTS.md",
    "README.md",
    "package-lock.json",
    "package.json",
    "vercel.json"
  ],
  "allowedRepoRootDirs": [
    ".github",
    "api",
    "config",
    "docs",
    "fixtures",
    "migrations",
    "offline-reports",
    "public",
    "scripts",
    "server",
    "standalone-services",
    "tests",
    "wechat-miniprogram",
    "_local"
  ],
  "ignoredRepoRootPatterns": [
    "^\\.DS_Store$",
    "^\\.env(?:\\..*)?$",
    "^\\.git$",
    "^\\.npm-cache$",
    "^\\.vercel$",
    "^\\.vercel-home$",
    "^\\.worktrees$",
    "^_exports$",
    "^node_modules$",
    "^tmp$",
    "^var$"
  ],
  "stalePhrases": [
    "没有 guard:release",
    "CI 只执行 npm test 和 npm run guard:finance",
    "没有独立只读真实接口冒烟命令",
    "flowtennis-mini-match-release 上传"
  ],
  "changeRecordRequiredFromLevel": "L2",
  "requiredChangeRecordSections": [
    "风险等级",
    "变更文件",
    "影响页面",
    "影响接口",
    "影响表",
    "影响指标",
    "测试映射",
    "决策同步",
    "异常豁免",
    "事故反馈闭环",
    "发布后核验"
  ],
  "requiredProductionSections": [
    "操作原因",
    "目标实例",
    "dry-run",
    "批次",
    "操作前快照",
    "操作后校验",
    "线上接口",
    "前端展示",
    "回滚方案"
  ],
  "decisionSyncTarget": "docs/prd/source/14-变更记录与决策记录.md",
  "decisionSyncMarker": "AUTO-SYNC-PRD-DECISIONS",
  "exceptionApprovalRequiredFields": [
    "审批人",
    "审批单号",
    "补验时间",
    "风险说明"
  ],
  "incidentClosureTriggerPatterns": [
    "^scripts/(repair|cleanup|apply|rollback|finalize|archive)-",
    "^offline-reports/repair-",
    "repair",
    "hotfix",
    "bug",
    "故障",
    "事故"
  ],
  "incidentClosureRequiredArtifacts": [
    "新增反例测试",
    "新增规则",
    "新增静态门禁",
    "新增监控规则",
    "新增文档说明",
    "新增架构边界"
  ],
  "riskLevels": {
    "L1": {
      "requiredChecks": [
        "npm run guard:governance-automation"
      ],
      "patterns": [
        "^docs/",
        "^config/",
        "^\\.github/workflows/ci-guard\\.yml$",
        "^package\\.json$"
      ]
    },
    "L2": {
      "requiredChecks": [
        "npm run guard:test-inventory"
      ],
      "patterns": [
        "^tests/",
        "^public/",
        "^server/",
        "^api/"
      ]
    },
    "L3": {
      "requiredChecks": [
        "npm test"
      ],
      "patterns": [
        "^server/read-models/",
        "^public/assets/scripts/core/",
        "^docs/business-rules/FlowTennis全平台数据口径总表\\.md$",
        "^docs/business-rules/平台核心数据字典\\.md$",
        "^docs/business-rules/reference/核心表关系图\\.md$",
        "^api/index\\.js$",
        "^scripts/governance-automation-guard\\.js$",
        "^tests/governance-automation-guard\\.test\\.js$",
        "^docs/prd/source/14-变更记录与决策记录\\.md$"
      ]
    },
    "L4": {
      "requiredChecks": [
        "npm run guard:finance",
        "npm run guard:release"
      ],
      "patterns": [
        "finance",
        "membership",
        "court",
        "purchase",
        "entitlement",
        "schedule",
        "财务",
        "会员",
        "订场",
        "课包",
        "权益",
        "排课"
      ]
    },
    "L5": {
      "requiredChecks": [
        "npm run guard:post-release"
      ],
      "patterns": [
        "^scripts/(repair|cleanup|apply|rollback|finalize|archive)-",
        "^offline-reports/"
      ]
    }
  },
  "ignoredChangedFilePatterns": [
    "^docs/governance/change-records/"
  ],
  "postReleaseRequiredChecks": [
    "/api/diag",
    "/server/page-data/finance",
    "/server/page-data/workbench",
    "/server/page-data/courts",
    "/server/page-data/memberships",
    "/server/page-data/purchases",
    "/server/page-data/plans",
    "/server/page-data/coaches"
  ]
}
